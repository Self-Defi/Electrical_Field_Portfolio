<!DOCTYPE html>
<html lang="en">

<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />

  <title>Electrical Field Portfolio</title>

  <link rel="stylesheet" href="styles.css" />
</head>

<body>

  <!-- =========================================
       HERO
  ========================================== -->
  <header class="hero">

    <div class="hero-content">
      <p class="eyebrow">FIELD SKILLS PORTFOLIO</p>

      <h1>Electrical Apprentice</h1>

      <p class="hero-subtitle">
        Commercial and residential electrical field experience.
      </p>

      <div class="hero-tags">
        <span>EMT</span>
        <span>Wire Pulling</span>
        <span>Rough-In</span>
        <span>Devices</span>
        <span>Low Voltage</span>
      </div>
    </div>

  </header>


  <!-- =========================================
       INTRO
  ========================================== -->
  <main>

    <section class="intro section">
      <div class="section-inner">

        <p class="section-label">FIELD EXPERIENCE</p>

        <h2>Selected Work</h2>

        <p class="section-description">
          Short examples of hands-on electrical work completed in training
          and active jobsite environments.
        </p>

      </div>
    </section>


    <!-- =========================================
         EMT / CONDUIT
    ========================================== -->
    <section class="skill-section section">

      <div class="section-inner">

        <div class="skill-heading">
          <span class="skill-number">01</span>

          <div>
            <p class="section-label">COMMERCIAL</p>
            <h2>EMT / Conduit</h2>
          </div>
        </div>

        <div class="media-card">

          <video
            controls
            playsinline
            preload="metadata"
            poster="assets/images/emt-cover.jpg"
          >
            <source src="assets/videos/emt.mp4" type="video/mp4" />
          </video>

          <img
            src="assets/images/emt.jpg"
            alt="Commercial EMT conduit installation"
          />

        </div>

        <p class="skill-description">
          Measured, bent, routed and installed EMT raceway in commercial
          construction environments.
        </p>

      </div>

    </section>


    <!-- =========================================
         CONDUCTOR INSTALLATION
    ========================================== -->
    <section class="skill-section section">

      <div class="section-inner">

        <div class="skill-heading">
          <span class="skill-number">02</span>

          <div>
            <p class="section-label">COMMERCIAL</p>
            <h2>Wire Pulling / Conductors</h2>
          </div>
        </div>

        <div class="media-card">

          <video
            controls
            playsinline
            preload="metadata"
            poster="assets/images/wire-pull-cover.jpg"
          >
            <source src="assets/videos/wire-pull.mp4" type="video/mp4" />
          </video>

          <img
            src="assets/images/wire-pull.jpg"
            alt="Commercial conductor installation"
          />

        </div>

        <p class="skill-description">
          Fed and pulled conductors through commercial raceway systems while
          maintaining circuit identification.
        </p>

      </div>

    </section>


    <!-- =========================================
         ROUGH-IN
    ========================================== -->
    <section class="skill-section section">

      <div class="section-inner">

        <div class="skill-heading">
          <span class="skill-number">03</span>

          <div>
            <p class="section-label">COMMERCIAL</p>
            <h2>Boxes / Rough-In</h2>
          </div>
        </div>

        <div class="media-card">

          <video
            controls
            playsinline
            preload="metadata"
            poster="assets/images/rough-in-cover.jpg"
          >
            <source src="assets/videos/rough-in.mp4" type="video/mp4" />
          </video>

          <img
            src="assets/images/rough-in.jpg"
            alt="Electrical box and rough-in installation"
          />

        </div>

        <p class="skill-description">
          Installed and worked around electrical boxes, raceways and branch
          circuit rough-in during active construction.
        </p>

      </div>

    </section>


    <!-- =========================================
         DEVICES
    ========================================== -->
    <section class="skill-section section">

      <div class="section-inner">

        <div class="skill-heading">
          <span class="skill-number">04</span>

          <div>
            <p class="section-label">RESIDENTIAL / COMMERCIAL</p>
            <h2>Devices / Terminations</h2>
          </div>
        </div>

        <div class="media-card">

          <video
            controls
            playsinline
            preload="metadata"
            poster="assets/images/devices-cover.jpg"
          >
            <source src="assets/videos/devices.mp4" type="video/mp4" />
          </video>

          <img
            src="assets/images/devices.jpg"
            alt="Electrical device termination"
          />

        </div>

        <p class="skill-description">
          Installed and terminated receptacles, switches and associated
          conductors using proper identification and workmanship practices.
        </p>

      </div>

    </section>


    <!-- =========================================
         LOW VOLTAGE
    ========================================== -->
    <section class="skill-section section">

      <div class="section-inner">

        <div class="skill-heading">
          <span class="skill-number">05</span>

          <div>
            <p class="section-label">LOW VOLTAGE</p>
            <h2>Data / CAT5e</h2>
          </div>
        </div>

        <div class="media-card">

          <video
            controls
            playsinline
            preload="metadata"
            poster="assets/images/data-cover.jpg"
          >
            <source src="assets/videos/data.mp4" type="video/mp4" />
          </video>

          <img
            src="assets/images/data.jpg"
            alt="CAT5e low voltage cable installation"
          />

        </div>

        <p class="skill-description">
          Routed and installed CAT5e low-voltage cabling during commercial
          rough-in.
        </p>

      </div>

    </section>


    <!-- =========================================
         TRAINING
    ========================================== -->
    <section class="training section">

      <div class="section-inner">

        <p class="section-label">TRAINING</p>

        <h2>Technical Development</h2>

        <p>
          Electrical and construction coursework supported by active
          on-the-job field experience.
        </p>

      </div>

    </section>

  </main>


  <!-- =========================================
       FOOTER
  ========================================== -->
  <footer>

    <div class="section-inner">
      <p>Electrical Field Portfolio</p>
    </div>

  </footer>


</body>

</html>
